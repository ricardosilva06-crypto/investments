# Copy to backend/.env and adjust. Nothing here needs a paid service.

# Required to sync the SEC EDGAR company list (SEC fair-access policy):
# a name for your app plus a contact e-mail address.
II_SEC_USER_AGENT="InvestorIntelligence (private use) your-email@example.com"

# Set to true when serving over HTTPS (Tailscale serve / Caddy). Required for
# installing the PWA and offline mode on phones.
II_COOKIE_SECURE=false

# Optional overrides
# II_DATA_DIR=./data
# II_SESSION_DAYS=30
# II_OLLAMA_URL=http://127.0.0.1:11434

# Optional end-of-day prices from Tiingo (free account, no card; free plan is
# licensed for internal/personal use with hourly/daily limits). Leave empty to
# use CSV imports only. The app stays under these self-imposed budgets:
# II_TIINGO_API_KEY=
# II_TIINGO_MAX_PER_HOUR=40
# II_TIINGO_MAX_PER_DAY=400

# Local AI analyst (Ollama, free and open source). Empty = first installed model.
# II_OLLAMA_URL=http://127.0.0.1:11434
# II_OLLAMA_CHAT_MODEL=llama3.1:8b
# II_OLLAMA_EMBED_MODEL=nomic-embed-text
# II_OLLAMA_NUM_CTX=8192
# II_MAX_UPLOAD_MB=25

# Background jobs (daily refresh + alerts, feeds, ECB rates, nightly backups), all in-process.
# II_SCHEDULER=true
# II_DAILY_JOB_HOUR_UTC=22
# II_BACKUP_HOUR_UTC=3
# II_BACKUPS_KEEP=14

# Hardening (recommended when reachable from other devices)
# II_ALLOWED_HOSTS=myserver.your-tailnet.ts.net,localhost
# II_API_DOCS=false
# Web Push contact sent to browser push services (required by the protocol)
# II_VAPID_CONTACT=mailto:you@example.com

# OCR for scanned PDFs (needs the free Tesseract engine installed on the server; see README)
# II_OCR=auto
# II_OCR_LANGUAGES=eng+por
# II_OCR_DPI=300
# II_OCR_MAX_PAGES=300

# Claude connector (optional; uses your own Claude subscription, see docs/CONNECTOR.md).
# Public HTTPS base URL of ./run-connector.sh, e.g. via Tailscale Funnel on port 8443. Empty = disabled.
# II_CONNECTOR_PUBLIC_URL=https://mac-mini.your-tailnet.ts.net:8443
# II_CONNECTOR_WRITE_TOOLS=true      # false = Claude can only read, never save notes
# II_CONNECTOR_ACCESS_MINUTES=60
# II_CONNECTOR_REFRESH_DAYS=30
